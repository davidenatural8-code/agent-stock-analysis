{
  "_about": "The design layer. Three tiers: primitive (the only literal values) -> semantic (roles) -> type/layout/component/charts (recipes). {braces} are aliases, resolved by scripts/tokens.py against the document root, then primitive.*, then semantic.*. Note semantic.chart is the chart palette while top-level 'charts' holds the per-type styling recipes. Editing this file restyles every generated deck; no script contains a font name, a colour, or any other visual value.",

  "primitive": {
    "color": {
      "ink900": "#141414",
      "gray600": "#6E6E6E",
      "gray400": "#9CA3AF",
      "gray300": "#D4D4D4",
      "gray200": "#E5E5E5",
      "white": "#FFFFFF",

      "terracotta": "#C4522F",
      "tan": "#E6BD8A",
      "sand": "#EDD8A8",
      "cream": "#F7F0C7",
      "sage": "#B8CDAE",
      "seafoam": "#6EA893",
      "teal": "#0A8A82",
      "pine": "#0B3B37"
    },

    "font": {
      "sans": "Inter",
      "sans_medium": "Inter Medium",
      "sans_semibold": "Inter SemiBold"
    },

    "size": {"xs": 9, "sm": 11, "md": 13, "lg": 14, "xl": 18, "xxl": 26, "hero": 40},

    "space": {"xs": 0.1, "sm": 0.2, "md": 0.35, "lg": 0.5}
  },

  "semantic": {
    "text": {
      "primary": "{color.ink900}",
      "secondary": "{color.gray600}",
      "heading": "{color.ink900}"
    },

    "surface": {
      "slide": "{color.white}",
      "band": "{color.white}"
    },

    "line": {
      "border": "{color.gray200}"
    },

    "chart": {
      "categorical": [
        "{color.terracotta}", "{color.tan}", "{color.sand}", "{color.cream}",
        "{color.sage}", "{color.seafoam}", "{color.teal}", "{color.pine}"
      ],
      "muted": "{color.gray200}",
      "axis": "{color.gray300}",
      "grid": "{color.gray200}",
      "label": "{color.gray600}"
    }
  },

  "type": {
    "title": {"font": "{font.sans_semibold}", "size": "{size.xxl}", "bold": false, "color": "{text.heading}", "line_height": 1.5},
    "subtitle": {"font": "{font.sans}", "size": "{size.lg}", "bold": false, "color": "{text.secondary}", "line_height": 1.9},
    "section": {"font": "{font.sans_semibold}", "size": "{size.hero}", "bold": false, "color": "{text.heading}", "line_height": 1.4},
    "card_title": {"font": "{font.sans_semibold}", "size": "{size.md}", "bold": false, "color": "{text.heading}", "line_height": 1.6},
    "body": {"font": "{font.sans}", "size": "{size.sm}", "bold": false, "color": "{text.primary}", "line_height": 1.45},
    "caption": {"font": "{font.sans}", "size": "{size.xs}", "bold": false, "color": "{text.secondary}", "line_height": 1.4},
    "footer": {"font": "{font.sans}", "size": "{size.xs}", "bold": false, "color": "{text.secondary}", "line_height": 1.4},
    "kpi_value": {"font": "{font.sans_semibold}", "size": "{size.hero}", "bold": false, "color": "{text.heading}", "line_height": 1.35},
    "kpi_label": {"font": "{font.sans}", "size": "{size.xs}", "bold": false, "color": "{text.secondary}", "line_height": 2.4},
    "lead": {"font": "{font.sans}", "size": "{size.xl}", "bold": false, "color": "{text.primary}", "line_height": 1.9}
  },

  "layout": {
    "canvas": {"w_in": 13.333, "h_in": 7.5},
    "margin": {"x_in": 0.6, "top_in": 0.5, "bottom_in": 0.5},
    "title_band": {"h_in": 1.05},
    "gap_in": "{space.md}",
    "inset_in": "{space.xs}",
    "paragraph_space_em": 0.6,

    "slide_type": {
      "content": {
        "background": "{surface.slide}",
        "logo": {"at": "top_left"},
        "title": {"role": "title", "at": "top_right"},
        "footer": true,
        "body": true
      },
      "home": {
        "background": "{surface.slide}",
        "logo": {"at": "top_left"},
        "title": {"role": "section", "at": "center"},
        "footer": false,
        "body": false
      }
    }
  },

  "logo": {"path": null, "text": "NP", "role": "card_title", "height_in": 0.35},

  "component": {
    "card": {"fill": "{surface.slide}", "shape": "ROUNDED_RECTANGLE", "border": "{line.border}", "shadow": false, "pad_in": "{space.md}", "title_gap_in": 0.08},
    "kpi": {"fill": "{surface.slide}", "shape": "ROUNDED_RECTANGLE", "border": "{line.border}", "shadow": false, "pad_in": "{space.md}", "title_gap_in": 0},
    "bullet": {"prefix": "•  ", "indent_in": 0.25},
    "footer_bar": {"fill": "{surface.band}", "height_in": 0.35, "text": "{type.footer}"}
  },

  "charts": {
    "_base": {
      "font": "{font.sans}",
      "font_size": "{size.xs}",
      "font_color": "{chart.label}",
      "chart_title": false,
      "grid_width_pt": 0.75,
      "axis_width_pt": 0.75,
      "legend": {"when_series_gte": 2, "position": "bottom", "in_layout": false},
      "value_axis": {"visible": true, "gridlines": true, "tick_marks": "none", "line": false},
      "category_axis": {"visible": true, "gridlines": false, "tick_marks": "none", "line": true},
      "data_labels": {"show": false, "number_format": "#,##0", "position": "outside_end"}
    },

    "bar": {
      "value_axis": {"visible": false, "gridlines": false},
      "data_labels": {"show": true},
      "gap_width": 60,
      "overlap": -10,
      "max_points_for_labels": 12
    },

    "bar_stacked": {
      "data_labels": {"show": false},
      "gap_width": 60,
      "overlap": 100
    },

    "bar_horizontal": {
      "value_axis": {"visible": false, "gridlines": false},
      "category_axis": {"line": false},
      "data_labels": {"show": true},
      "gap_width": 50,
      "overlap": -10,
      "max_points_for_labels": 12
    },

    "line": {"smooth": false, "width_pt": 2.25, "marker": "none"},

    "area": {"smooth": false},

    "pie": {
      "legend": {"when_series_gte": 1},
      "data_labels": {"show": true, "show_percentage": true, "show_value": false, "number_format": "0%"},
      "max_slices": 6
    }
  },

  "rules": {"max_series": 8, "single_value_use_kpi": true}
}
